# LeadPilot AI — copy to backend/.env and fill in. Placeholder values only.
# Most settings also have UI/config defaults; only set what you need.

# --- Database (Docker PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/leadpilot

# --- AI (Ollama, local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# --- Gmail / outreach ---
GMAIL_ENABLED=true

# --- Official WhatsApp Business Platform / Cloud API ---
# No unofficial WhatsApp Web automation is used anywhere in this project.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# --- Google OAuth (Gmail + Calendar). Can also be pasted in Settings UI. ---
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# --- App ---
MEETING_DURATION_MINUTES=30
FOLLOWUP_DELAY_HOURS=24
APP_URL=http://localhost:8001
FRONTEND_URL=http://localhost:5173
SECRET_KEY=change-me-in-production
